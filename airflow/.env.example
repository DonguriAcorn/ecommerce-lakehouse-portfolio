# 本物は airflow/.env(Git の管理外)。値は次のコマンドで、ランダムに作る(プロジェクト直下で)
# test -f airflow/.env || printf 'POSTGRES_PASSWORD=%s\nAIRFLOW_ADMIN_PASSWORD=%s\nAIRFLOW_JWT_SECRET=%s\n' "$(openssl rand -hex 16)" "$(openssl rand -hex 12)" "$(openssl rand -hex 32)" > airflow/.env
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
